{
  "name": "agentic-controlroom",
  "displayName": "Agentic Control Room",
  "version": "0.1.0",
  "description": "Multi-agent coding chatroom: specialized agents (Dev, QA, ...) coordinate on a task via a shared live log, powered by pluggable backends (Cursor CLI by default).",
  "publisher": "agentic-controlroom",
  "type": "module",
  "main": "./dist/extension.cjs",
  "bin": {
    "agentic-controlroom": "./dist/cli.js"
  },
  "files": [
    "dist",
    "roles",
    "skills",
    "media"
  ],
  "engines": {
    "node": ">=24",
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "agenticControlRoom.runTask",
        "title": "Agentic Control Room: Run Task"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agenticControlRoom",
          "title": "Agentic Control Room",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agenticControlRoom": [
        {
          "type": "webview",
          "id": "agenticControlRoom.chat",
          "name": "Chatroom"
        }
      ]
    },
    "configuration": {
      "title": "Agentic Control Room",
      "properties": {
        "agenticControlRoom.model": {
          "type": "string",
          "default": "",
          "description": "Model passed to cursor-agent as --model (empty = Cursor's default)."
        },
        "agenticControlRoom.maxRounds": {
          "type": "number",
          "default": 3,
          "description": "Maximum Dev/QA rounds before giving up."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc && npm run build:ext && npm run build:desktop",
    "build:ext": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "build:desktop": "esbuild src/desktop/main.ts --bundle --platform=node --format=cjs --external:electron --external:node-pty --external:better-sqlite3 --outfile=dist/desktop/main.cjs && esbuild src/desktop/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/desktop/preload.cjs && tsc -p tsconfig.renderer.json --noEmit && vite build --config src/desktop/renderer/vite.config.ts",
    "app": "npm run build && electron dist/desktop/main.cjs",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "package": "npm run build && vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vscode/vsce": "^3.0.0",
    "electron": "^44.0.0",
    "esbuild": "^0.24.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@toon-format/toon": "4.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.37.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "zustand": "^5.0.0"
  },
  "exports": {
    "./graph": {
      "types": "./dist/orchestrator/graph.d.ts",
      "import": "./dist/orchestrator/graph.js"
    },
    "./backend": {
      "types": "./dist/backend/agentBackend.d.ts",
      "import": "./dist/backend/agentBackend.js"
    },
    "./http-backend": {
      "types": "./dist/backend/httpBackend.d.ts",
      "import": "./dist/backend/httpBackend.js"
    },
    "./chat-log": {
      "types": "./dist/chatroom/log.d.ts",
      "import": "./dist/chatroom/log.js"
    },
    "./context": {
      "types": "./dist/workflow/context.d.ts",
      "import": "./dist/workflow/context.js"
    },
    "./workflow": {
      "types": "./dist/workflow/runtime.d.ts",
      "import": "./dist/workflow/runtime.js"
    },
    "./artifacts": {
      "types": "./dist/workflow/artifacts.d.ts",
      "import": "./dist/workflow/artifacts.js"
    },
    "./project-integration": {
      "types": "./dist/workflow/projectIntegration.d.ts",
      "import": "./dist/workflow/projectIntegration.js"
    }
  }
}
