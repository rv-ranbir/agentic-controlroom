{
  "name": "agent-room",
  "displayName": "Agent Room",
  "version": "0.1.0",
  "description": "Multi-agent coding chatroom: specialized agents (Dev, QA, ...) coordinate on a task via a shared live log, powered by pluggable backends (Cursor CLI by default).",
  "publisher": "agent-room",
  "type": "module",
  "main": "./dist/extension.cjs",
  "bin": {
    "agent-room": "./dist/cli.js"
  },
  "files": [
    "dist",
    "roles",
    "skills",
    "media"
  ],
  "engines": {
    "node": ">=24",
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "agent-room.runTask",
        "title": "Agent Room: Run Task"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentRoom",
          "title": "Agent Room",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentRoom": [
        {
          "type": "webview",
          "id": "agentRoom.chat",
          "name": "Chatroom"
        }
      ]
    },
    "configuration": {
      "title": "Agent Room",
      "properties": {
        "agentRoom.model": {
          "type": "string",
          "default": "",
          "description": "Model passed to cursor-agent as --model (empty = Cursor's default)."
        },
        "agentRoom.maxRounds": {
          "type": "number",
          "default": 3,
          "description": "Maximum Dev/QA rounds before giving up."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc && npm run build:ext && npm run build:desktop",
    "build:ext": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "build:desktop": "esbuild src/desktop/main.ts --bundle --platform=node --format=cjs --external:electron --external:node-pty --external:better-sqlite3 --outfile=dist/desktop/main.cjs && esbuild src/desktop/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/desktop/preload.cjs && tsc -p tsconfig.renderer.json --noEmit && vite build --config src/desktop/renderer/vite.config.ts",
    "app": "npm run build && electron dist/desktop/main.cjs",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "package": "npm run build && vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vscode/vsce": "^3.0.0",
    "electron": "^44.0.0",
    "esbuild": "^0.24.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  }
}
